# WebEye configuration — copy to .env and edit.
# Every value is optional — WebEye runs with no configuration at all.

# --- access ------------------------------------------------------------------
# There is nothing to configure: WebEye uses user accounts. Open the site and
# click "Create account" — the first account created claims the instance.
# Registration is open by default, so put the instance behind a VPN or your
# proxy's auth if you don't want strangers signing up.

# --- alerts (all optional) ---------------------------------------------------
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any other service: receives the raw JSON event as a POST body
GENERIC_WEBHOOK_URL=

# --- server ------------------------------------------------------------------
PORT=3000
# In Docker this should be /data/monitor.db so it lands on the volume.
DB_PATH=./data/monitor.db

# --- tuning ------------------------------------------------------------------
# Warn when a TLS certificate has fewer than this many days left.
SSL_WARN_DAYS=14
# Consecutive failures before a service is declared down and alerts fire.
FAILURES_BEFORE_DOWN=2
# Maximum simultaneous outbound checks.
CONCURRENCY=10
# How long individual check rows are kept before being rolled into daily stats.
RETAIN_RAW_DAYS=7
